  m_Script: {fileID: 11500000, guid: f974ebb5cd41de74683ff3a0eb9cb068, type: 3}
  m_Name: Lore-en-2
  m_EditorClassIdentifier: 
  language: 0
  title: 
  text: 'Today, in 2003, Ethan no longer writes. What he saw in those years stayed with him: post-traumatic stress disorder that turns every sound into a threat and erases whole hours from his memory.


    During an episode, his vision narrows, the air grows heavy, and 1996 happens all over again.


    The medication calms the episodes. It also keeps the memories just out of reach.'
  displayDuration: 30
  isSkippable: 1
