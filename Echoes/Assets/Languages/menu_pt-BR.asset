    m_Metadata:
      m_Items: []
  - m_Id: 143087558379479040
    m_Localized: "Echoes \u2014 Cap\xEDtulo 1\n\nObrigado por jogar a demo.\nAdicione \xE0 sua lista de desejos na Steam."
    m_Metadata:
