  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: track_1_pt-BR
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: 8a795d790bcfa814ca9a7c445c143efb, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 151929073664
    m_Localized: "Aqui \xE9 WZNY Not\xEDcias. Retomando o plant\xE3o de not\xEDcias
      urgentes que t\xEAm abalado a calmaria de Harrow Creek..."
    m_Metadata:
      m_Items: []
  - m_Id: 216307445760
    m_Localized: "Tr\xEAs v\xEDtimas foram confirmadas como mortas na \xFAltima semana,
      brutalmente atacadas."
    m_Metadata:
      m_Items: []
  - m_Id: 239778770944
    m_Localized: "Autoridades confirmam que o padr\xE3o de viol\xEAncia e o modus
      operandi s\xE3o id\xEAnticos..."
    m_Metadata:
      m_Items: []
  - m_Id: 7023348264960
    m_Localized: "... aos crimes do famoso \"A\xE7ougueiro de Harrow Creek\", o serial
      killer que aterrorizou a cidade na d\xE9cada de 90."
    m_Metadata:
      m_Items: []
  - m_Id: 7046005895168
    m_Localized: "A pol\xEDcia havia dado o principal suspeito como desaparecido
      ou, presumivelmente, morto, mas..."
    m_Metadata:
      m_Items: []
  - m_Id: 7069187813376
    m_Localized: ...Parece que o fantasma retornou para clamar novas vidas.
    m_Metadata:
      m_Items: []
  - m_Id: 7088208982016
    m_Localized: "Voc\xEA lembra do papel, n\xE3o \xE9? Aquele com as manchas."
    m_Metadata:
      m_Items: []
  - m_Id: 7106173186048
    m_Localized: "A recomenda\xE7\xE3o \xE9 clara:"
    m_Metadata:
      m_Items: []
  - m_Id: 7125529899008
    m_Localized: "Cidad\xE3os devem evitar andar sozinhos ap\xF3s o anoitecer. Evitem
      \xE1reas isoladas."
    m_Metadata:
      m_Items: []
  - m_Id: 7900624695296
    m_Localized: "*Voc\xEA tem que procurar.* qualquer atividade suspeita, liguem
      para o 911."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
