  m_TableData:
  - m_Id: 1354539018
    m_Localized: This goes on the board.
    m_Metadata:
      m_Items: []
  - m_Id: 329353262833664
    m_Localized: Ledger clipping
    m_Metadata:
      m_Items: []
  - m_Id: 329353300582400
    m_Localized: '"Waitress is the Butcher''s third victim." Story by Ethan Myers, photos by Clara Reyes.'
    m_Metadata:
      m_Items: []
  - m_Id: 329353300582401
    m_Localized: Halley boarding house, 41 Halley Street
    m_Metadata:
      m_Items: []
  - m_Id: 329353300582402
    m_Localized: Notes from the bulletin
    m_Metadata:
      m_Items: []
  - m_Id: 329353300582403
    m_Localized: 'WZNY, 10:50 p.m.: a woman''s body at the old Halley boarding house, second floor. Police won''t confirm the cause.'
    m_Metadata:
      m_Items: []
  - m_Id: 329353300582404
    m_Localized: 41 Halley Street
    m_Metadata:
      m_Items: []
  - m_Id: 329353304776704
    m_Localized: Neighbor's note
    m_Metadata:
      m_Items: []
  - m_Id: 329353304776705
    m_Localized: Slipped under the door. A complaint about my radio at three in the morning. On the back, a shopping list and an address.
    m_Metadata:
      m_Items: []
  - m_Id: 329353304776706
    m_Localized: 41 Halley Street
    m_Metadata:
      m_Items: []
  - m_Id: 329353304776707
    m_Localized: New Leaf report
    m_Metadata:
      m_Items: []
  - m_Id: 329353304776708
    m_Localized: PTSD with dissociative symptoms. Serenil at the first sign of an episode. Stay away from the peephole.
    m_Metadata:
      m_Items: []
  - m_Id: 329353304776709
    m_Localized: New Leaf Clinic
    m_Metadata:
      m_Items: []
  - m_Id: 329353304776710
    m_Localized: Eight years later, he went back to the Halley boarding house.
    m_Metadata:
      m_Items: []
  - m_Id: 329353304776711
    m_Localized: The same place. He wants someone to remember.
    m_Metadata:
      m_Items: []
  - m_Id: 329353304776712
    m_Localized: The neighbor has the boarding house's address.
    m_Metadata:
      m_Items: []
  - m_Id: 329353304776713
    m_Localized: I knew it. I knew it was him.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
