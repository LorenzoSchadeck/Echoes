  m_TableData:
  - m_Id: 1262264320
    m_Localized: 'Clipping: third victim'
    m_Metadata:
      m_Items: []
  - m_Id: 1354539008
    m_Localized: Woman found dead on Halley Street. Police have no suspects.
    m_Metadata:
      m_Items: []
  - m_Id: 1354539009
    m_Localized: Halley Street
    m_Metadata:
      m_Items: []
  - m_Id: 1354539010
    m_Localized: Neighbor's note
    m_Metadata:
      m_Items: []
  - m_Id: 1354539011
    m_Localized: It slid under the door. A shopping list; an address on the back.
    m_Metadata:
      m_Items: []
  - m_Id: 1354539012
    m_Localized: 41 Halley Street
    m_Metadata:
      m_Items: []
  - m_Id: 1354539013
    m_Localized: Prescription
    m_Metadata:
      m_Items: []
  - m_Id: 1354539014
    m_Localized: 'Diazepam, 10 mg. Patient: E. Myers. The doctor''s signature is smudged.'
    m_Metadata:
      m_Items: []
  - m_Id: 1354539015
    m_Localized: St. Luke's Clinic
    m_Metadata:
      m_Items: []
  - m_Id: 1354539016
    m_Localized: The neighbor was on Halley Street the day of the third murder.
    m_Metadata:
      m_Items: []
  - m_Id: 1354539017
    m_Localized: I knew it. I knew it was him.
    m_Metadata:
      m_Items: []
  - m_Id: 1354539018
    m_Localized: This goes on the board.
    m_Metadata:
      m_Items: []
