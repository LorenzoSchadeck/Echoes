  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: inner_voice_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: da29c9c5130db064a82c8feeb2b842a3, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1480368128
    m_Localized: How long was I out?
    m_Metadata:
      m_Items: []
  - m_Id: 1602002944
    m_Localized: Again. The couch again.
    m_Metadata:
      m_Items: []
  - m_Id: 1606197248
    m_Localized: I don't remember sitting down.
    m_Metadata:
      m_Items: []
  - m_Id: 1606197249
    m_Localized: What time is it? No... that can't be right.
    m_Metadata:
      m_Items: []
  - m_Id: 1606197250
    m_Localized: Where was I?
    m_Metadata:
      m_Items: []
  - m_Id: 1606197251
    m_Localized: Just one more. So I don't have to think.
    m_Metadata:
      m_Items: []
  - m_Id: 1606197252
    m_Localized: It's getting quiet. Good.
    m_Metadata:
      m_Items: []
  - m_Id: 1606197253
    m_Localized: Breathe, Ethan. Just breathe.
    m_Metadata:
      m_Items: []
  - m_Id: 1610391552
    m_Localized: The walls... are they closer?
    m_Metadata:
      m_Items: []
  - m_Id: 288652835725312
    m_Localized: Three in the morning? I didn't turn the radio on last night.
    m_Metadata:
      m_Items: []
  - m_Id: 331302355902464
    m_Localized: I need to write this down before I forget.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
