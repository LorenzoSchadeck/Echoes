  m_TableData:
  - m_Id: 1262264320
    m_Localized: "Recorte: terceira v\xEDtima"
    m_Metadata:
      m_Items: []
  - m_Id: 1354539008
    m_Localized: "Mulher encontrada morta na Rua Halley. A pol\xEDcia n\xE3o tem suspeitos."
    m_Metadata:
      m_Items: []
  - m_Id: 1354539009
    m_Localized: Rua Halley
    m_Metadata:
      m_Items: []
  - m_Id: 1354539010
    m_Localized: Bilhete do vizinho
    m_Metadata:
      m_Items: []
  - m_Id: 1354539011
    m_Localized: "Caiu por baixo da porta. Uma lista de compras; no verso, um endere\xE7o."
    m_Metadata:
      m_Items: []
  - m_Id: 1354539012
    m_Localized: Rua Halley, 41
    m_Metadata:
      m_Items: []
  - m_Id: 1354539013
    m_Localized: "Receita m\xE9dica"
    m_Metadata:
      m_Items: []
  - m_Id: 1354539014
    m_Localized: "Diazepam, 10 mg. Paciente: E. Myers. A assinatura do m\xE9dico est\xE1 borrada."
    m_Metadata:
      m_Items: []
  - m_Id: 1354539015
    m_Localized: "Cl\xEDnica S\xE3o Lucas"
    m_Metadata:
      m_Items: []
  - m_Id: 1354539016
    m_Localized: O vizinho esteve na Rua Halley no dia da terceira morte.
    m_Metadata:
      m_Items: []
  - m_Id: 1354539017
    m_Localized: Eu sabia. Eu sabia que era ele.
    m_Metadata:
      m_Items: []
  - m_Id: 1354539018
    m_Localized: Isso vai pro mural.
    m_Metadata:
      m_Items: []
