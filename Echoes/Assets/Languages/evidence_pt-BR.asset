  m_TableData:
  - m_Id: 1354539018
    m_Localized: Isso vai pro mural.
    m_Metadata:
      m_Items: []
  - m_Id: 329353262833664
    m_Localized: Recorte do Ledger
    m_Metadata:
      m_Items: []
  - m_Id: 329353300582400
    m_Localized: "\"Gar\xE7onete \xE9 a terceira v\xEDtima do A\xE7ougueiro.\" Texto de Ethan Myers, fotos de Clara Reyes."
    m_Metadata:
      m_Items: []
  - m_Id: 329353300582401
    m_Localized: "Pens\xE3o Halley, Rua Halley, 41"
    m_Metadata:
      m_Items: []
  - m_Id: 329353300582402
    m_Localized: "Anota\xE7\xE3o do boletim"
    m_Metadata:
      m_Items: []
  - m_Id: 329353300582403
    m_Localized: "WZNY, 22h50: corpo de mulher na antiga Pens\xE3o Halley, segundo andar. A pol\xEDcia n\xE3o confirma a causa."
    m_Metadata:
      m_Items: []
  - m_Id: 329353300582404
    m_Localized: Rua Halley, 41
    m_Metadata:
      m_Items: []
  - m_Id: 329353304776704
    m_Localized: Bilhete do vizinho
    m_Metadata:
      m_Items: []
  - m_Id: 329353304776705
    m_Localized: "Passado por baixo da porta. Reclama do meu r\xE1dio \xE0s tr\xEAs da manh\xE3. No verso, uma lista de compras e um endere\xE7o."
    m_Metadata:
      m_Items: []
  - m_Id: 329353304776706
    m_Localized: Rua Halley, 41
    m_Metadata:
      m_Items: []
  - m_Id: 329353304776707
    m_Localized: Laudo da New Leaf
    m_Metadata:
      m_Items: []
  - m_Id: 329353304776708
    m_Localized: "TEPT com sintomas dissociativos. Serenil ao primeiro sinal de crise. Evitar o olho m\xE1gico."
    m_Metadata:
      m_Items: []
  - m_Id: 329353304776709
    m_Localized: "Cl\xEDnica New Leaf"
    m_Metadata:
      m_Items: []
  - m_Id: 329353304776710
    m_Localized: "Oito anos depois, ele voltou para a Pens\xE3o Halley."
    m_Metadata:
      m_Items: []
  - m_Id: 329353304776711
    m_Localized: "O mesmo lugar. Ele quer que algu\xE9m lembre."
    m_Metadata:
      m_Items: []
  - m_Id: 329353304776712
    m_Localized: "O vizinho tem o endere\xE7o da pens\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 329353304776713
    m_Localized: Eu sabia. Eu sabia que era ele.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
