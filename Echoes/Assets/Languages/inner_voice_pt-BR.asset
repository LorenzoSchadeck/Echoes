  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: inner_voice_pt-BR
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: da29c9c5130db064a82c8feeb2b842a3, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1480368128
    m_Localized: Quanto tempo eu fiquei apagado?
    m_Metadata:
      m_Items: []
  - m_Id: 1602002944
    m_Localized: "De novo. O sof\xE1 de novo."
    m_Metadata:
      m_Items: []
  - m_Id: 1606197248
    m_Localized: "Eu n\xE3o lembro de ter sentado aqui."
    m_Metadata:
      m_Items: []
  - m_Id: 1606197249
    m_Localized: "Que horas s\xE3o? N\xE3o... n\xE3o pode ser."
    m_Metadata:
      m_Items: []
  - m_Id: 1606197250
    m_Localized: Onde eu estava?
    m_Metadata:
      m_Items: []
  - m_Id: 1606197251
    m_Localized: "S\xF3 mais um. Pra n\xE3o pensar."
    m_Metadata:
      m_Items: []
  - m_Id: 1606197252
    m_Localized: "T\xE1 ficando quieto. Bom."
    m_Metadata:
      m_Items: []
  - m_Id: 1606197253
    m_Localized: Respira, Ethan. Respira.
    m_Metadata:
      m_Items: []
  - m_Id: 1610391552
    m_Localized: "As paredes... est\xE3o mais perto?"
    m_Metadata:
      m_Items: []
  - m_Id: 288652835725312
    m_Localized: "\xC0s tr\xEAs da manh\xE3? Eu n\xE3o liguei o r\xE1dio essa noite."
    m_Metadata:
      m_Items: []
  - m_Id: 331302355902464
    m_Localized: "Preciso anotar isso antes que eu esque\xE7a."
    m_Metadata:
      m_Items: []
  - m_Id: 976341318803456
    m_Localized: "Quem est\xE1 a\xED?"
    m_Metadata:
      m_Items: []
  - m_Id: 2180425996607488
    m_Localized: "Eu escrevi isso. Estive naquele quarto com Clara. O que ficou fora da mat\xE9ria?"
    m_Metadata:
      m_Items: []
  - m_Id: 2180426088882176
    m_Localized: "Outra mulher na Halley. O locutor n\xE3o disse o quarto, mas eu ouvi seis. De onde veio isso?"
    m_Metadata:
      m_Items: []
  - m_Id: 2180426088882177
    m_Localized: "\xC0s tr\xEAs da manh\xE3? Eu estava dormindo. Pelo menos \xE9 disso que eu lembro."
    m_Metadata:
      m_Items: []
  - m_Id: 2180426088882178
    m_Localized: "Ela chama de apag\xE3o. Para mim \xE9 s\xF3 um peda\xE7o da noite que n\xE3o est\xE1 l\xE1."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
