  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: ItemsSubtitles_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 0d1da9d262f83e74082fbd9ced09307e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6248312832
    m_Localized: "A perfect mix\u2026 for anyone trying to forget they\u2019re still
      alive."
    m_Metadata:
      m_Items: []
  - m_Id: 16046206976
    m_Localized: "Forensic reports\u2026 I never know if I keep them for the job\u2026
      or to be sure of what they haven\u2019t uncovered."
    m_Metadata:
      m_Items: []
  - m_Id: 1375692763136
    m_Localized: "Funny\u2026 the more trash piles up in here, the more it feels
      like it\u2019s not just the house that\u2019s rotting."
    m_Metadata:
      m_Items: []
  - m_Id: 10012364484608
    m_Localized: It's dead. Typical. Right when an idea strikes.
    m_Metadata:
      m_Items: []
  - m_Id: 14056139108352
    m_Localized: 'Looks like a miniature crime scene. The suspect: laziness. The
      victim: my dignity.'
    m_Metadata:
      m_Items: []
  - m_Id: 12771612536832
    m_Localized: Turn on the TV to see more misery? No, thanks. Reality already pays
      me for that.
    m_Metadata:
      m_Items: []
  - m_Id: 12792416284672
    m_Localized: The ghosts of the past, all neatly organized. Good to keep them
      close, you never know when an old piece fits a new puzzle.
    m_Metadata:
      m_Items: []
  - m_Id: 12739656134656
    m_Localized: Memories from journalism school. And... anatomy books. Honestly,
      I don't remember why I bought these.
    m_Metadata:
      m_Items: []
  - m_Id: 17349221396480
    m_Localized: A timer. To remind me to take a simple pill. It's humiliating that
      a man like me needs this.
    m_Metadata:
      m_Items: []
  - m_Id: 20363135004672
    m_Localized: Sometimes, I think I remember what's inside. A smell... metallic.
      But the memory fades. It's probably just my imagination.
    m_Metadata:
      m_Items: []
  - m_Id: 21062455504896
    m_Localized: My refrigerator. A study in minimalism... and a bit of desperation.
      I think there's a lightbulb and a bottle of water in here.
    m_Metadata:
      m_Items: []
  - m_Id: 36870686617600
    m_Localized: (E) Inspect
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
