  m_SharedData: {fileID: 11400000, guid: 127465aa726d437408f1f50df4321569, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 4033720320
    m_Localized: WZNY News is back on the air. Thank you for tuning in with us, Ethan.
    m_Metadata:
      m_Items: []
  - m_Id: 57968275456
    m_Localized: The city is still in a panic, but the worst secrets aren't out there.
    m_Metadata:
      m_Items: []
  - m_Id: 73751441408
    m_Localized: They are in your home, aren't they? You searched so hard for me...
    m_Metadata:
      m_Items: []
  - m_Id: 106500567040
    m_Localized: You were so close to understanding. What happened to all that clarity,
      journalist?
    m_Metadata:
      m_Items: []
  - m_Id: 118030708736
    m_Localized: Perhaps your medication severed the line of inquiry... yours and
      the police's.
    m_Metadata:
      m_Items: []
  - m_Id: 141011300352
    m_Localized: But the truth is hard to kill. It's mixed up in your belongings.
    m_Metadata:
      m_Items: []
  - m_Id: 156987404288
    m_Localized: Your neighbor... He's so close. He saw you. Or was it you who was
      watching him? You can't tell who is who anymore.
    m_Metadata:
      m_Items: []
  - m_Id: 170673418240
    m_Localized: 'Listen closely, Ethan. The next step will be taken by your ears... '
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
