  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: ItemsSubtitles_pt-BR
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: 0d1da9d262f83e74082fbd9ced09307e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6248312832
    m_Localized: "\xD3tima combina\xE7\xE3o\u2026 pra quem quer esquecer que ainda
      est\xE1 vivo."
    m_Metadata:
      m_Items: []
  - m_Id: 16046206976
    m_Localized: "Relat\xF3rios da per\xEDcia\u2026 Nunca sei se os guardo pelo trabalho\u2026
      ou pra ter certeza do que eles n\xE3o descobriram."
    m_Metadata:
      m_Items: []
  - m_Id: 1375692763136
    m_Localized: "Engra\xE7ado\u2026 quanto mais lixo se acumula aqui, mais sinto
      que n\xE3o \xE9 s\xF3 a casa que est\xE1 apodrecendo."
    m_Metadata:
      m_Items: []
  - m_Id: 10012364484608
    m_Localized: "Est\xE1 descarregado. T\xEDpico. Bem na hora que uma ideia surge."
    m_Metadata:
      m_Items: []
  - m_Id: 14056139108352
    m_Localized: "Parece uma cena de crime em miniatura. O suspeito: pregui\xE7a.
      A v\xEDtima: minha dignidade."
    m_Metadata:
      m_Items: []
  - m_Id: 12771612536832
    m_Localized: "Ligar a TV pra ver mais desgra\xE7a? N\xE3o, obrigado. A realidade
      j\xE1 me paga pra isso."
    m_Metadata:
      m_Items: []
  - m_Id: 12792416284672
    m_Localized: "Os fantasmas do passado, todos bem organizados. \xC9 bom manter
      perto, nunca se sabe quando uma pe\xE7a antiga se encaixa num quebra-cabe\xE7a
      novo."
    m_Metadata:
      m_Items: []
  - m_Id: 12739656134656
    m_Localized: "Lembran\xE7as da faculdade de jornalismo. E... livros de anatomia.
      Sinceramente, n\xE3o lembro por que comprei isso."
    m_Metadata:
      m_Items: []
  - m_Id: 17349221396480
    m_Localized: "Um timer. Para me lembrar de tomar um simples rem\xE9dio. Chega
      a ser humilhante um homem como eu precisar disso."
    m_Metadata:
      m_Items: []
  - m_Id: 20363135004672
    m_Localized: "\xC0s vezes, acho que lembro o que tem a\xED dentro. Um cheiro...
      met\xE1lico. Mas a mem\xF3ria some. Provavelmente \xE9 s\xF3 minha imagina\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 21062455504896
    m_Localized: "Minha geladeira. Um estudo em minimalismo... e um pouco de desespero.
      Acho que tem uma luz e uma garrafa d'\xE1gua."
    m_Metadata:
      m_Items: []
  - m_Id: 36870686617600
    m_Localized: (E) Inspecionar
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
