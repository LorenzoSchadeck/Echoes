  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: track_2_pt-BR
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: 5933e423417603f41be254bea44d62b5, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5715636224
    m_Localized: "A tens\xE3o em Harrow Creek \xE9 palp\xE1vel. O toque de recolher
      mant\xE9m a maioria em casa, mas o medo \xE9 nosso novo convidado."
    m_Metadata:
      m_Items: []
  - m_Id: 8202858496
    m_Localized: "O p\xE2nico social levou a um aumento de den\xFAncias falsas. Psic\xF3logos
      alertam: Desconfiar \xE9 natural, mas a paranoia \xE9 contagiosa."
    m_Metadata:
      m_Items: []
  - m_Id: 10224513024
    m_Localized: "Olhe. Pelo. M\xE1gico. Apenas para ter certeza. Ele est\xE1 se
      movendo agora."
    m_Metadata:
      m_Items: []
  - m_Id: 12044840960
    m_Localized: "Lembrem-se: o A\xE7ougueiro dos anos 90 era discreto. Seu vizinho,
      seu amigo, seu colega... podem ser o perigo."
    m_Metadata:
      m_Items: []
  - m_Id: 14301376512
    m_Localized: "Voc\xEA viu o bilhete. Ele quer conversar. O que voc\xEA vai dizer
      a ele?"
    m_Metadata:
      m_Items: []
  - m_Id: 15333175296
    m_Localized: "A pol\xEDcia continua sem pistas concretas. A esperan\xE7a de um
      final r\xE1pido se esvai a cada noite em Harrow Creek."
    m_Metadata:
      m_Items: []
  - m_Id: 15991681024
    m_Localized: "N\xE3o abram a porta para estranhos, nem mesmo para rostos familiares.
      A cidade n\xE3o \xE9 segura."
    m_Metadata:
      m_Items: []
  - m_Id: 16654381056
    m_Localized: 'Repetindo: procurem por QUALQUER detalhe fora do lugar...'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
