  m_SharedData: {fileID: 11400000, guid: 5933e423417603f41be254bea44d62b5, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5715636224
    m_Localized: "WZNY, plant\xE3o da noite. A tempestade derrubou a energia em parte da zona norte."
    m_Metadata:
      m_Items: []
  - m_Id: 8202858496
    m_Localized: "Com o medo, as den\xFAncias falsas triplicaram desde ontem. Psic\xF3logos lembram que desconfiar \xE9 natural, mas que a paranoia se espalha r\xE1pido."
    m_Metadata:
      m_Items: []
  - m_Id: 10224513024
    m_Localized: "...olhe pelo olho m\xE1gico..."
    m_Metadata:
      m_Items: []
  - m_Id: 12044840960
    m_Localized: "Nos anos 90, o A\xE7ougueiro nunca foi visto entrando ou saindo. Para os vizinhos, era algu\xE9m comum."
    m_Metadata:
      m_Items: []
  - m_Id: 14301376512
    m_Localized: "A pol\xEDcia confirma que a v\xEDtima da Pens\xE3o Halley morreu entre uma e duas da manh\xE3."
    m_Metadata:
      m_Items: []
  - m_Id: 15333175296
    m_Localized: "Ainda n\xE3o h\xE1 suspeitos. O delegado Cole pede que quem passou pela Rua Halley ontem \xE0 noite procure a pol\xEDcia."
    m_Metadata:
      m_Items: []
  - m_Id: 15991681024
    m_Localized: "N\xE3o abram a porta para estranhos. Nem para rostos conhecidos."
    m_Metadata:
      m_Items: []
  - m_Id: 16654381056
    m_Localized: WZNY. Fiquem em casa.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
