<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="options-panel" class="options-panel">
        <ui:VisualElement class="tabs">
            <ui:Button name="tab-previous" text="Q" class="glyph tab-glyph" focusable="false" />
            <ui:Button name="tab-game" text="M_TAB_GAME" class="tab" focusable="false" />
            <ui:Button name="tab-video" text="M_TAB_VIDEO" class="tab" focusable="false" />
            <ui:Button name="tab-audio" text="M_TAB_AUDIO" class="tab" focusable="false" />
            <ui:Button name="tab-controls" text="M_TAB_CONTROLS" class="tab" focusable="false" />
            <ui:Button name="tab-access" text="M_TAB_ACCESS" class="tab" focusable="false" />
            <ui:Button name="tab-next" text="E" class="glyph tab-glyph" focusable="false" />
        </ui:VisualElement>
        <ui:VisualElement class="options-body">
            <ui:ScrollView name="pane-host" mode="Vertical" horizontal-scroller-visibility="Hidden" class="pane-host">
                <ui:VisualElement name="pane-game" class="pane">
                    <ui:Label text="M_LAN" class="section section--first" />
                    <ui:DropdownField name="dropdown-language" label="M_LAN" class="option" />
                    <ui:Label text="M_SEC_SUBTITLES" class="section" />
                    <OnOffField name="toggle-subtitles" label="M_SUBTITLES" class="option" />
                    <ui:Slider name="slider-subtitle-size" label="M_SUB_SIZE" low-value="0.75" high-value="1.5" class="option" />
                </ui:VisualElement>
                <ui:VisualElement name="pane-video" class="pane">
                    <ui:Label text="M_SEC_DISPLAY" class="section section--first" />
                    <ui:DropdownField name="dropdown-resolution" label="M_RESOLUTION" class="option" />
                    <ui:DropdownField name="dropdown-window" label="M_WINDOW" class="option" />
                    <ui:DropdownField name="dropdown-quality" label="M_QUALITY" class="option" />
                    <ui:Label text="M_SEC_IMAGE" class="section" />
                    <ui:Slider name="slider-fov" label="M_FOV" low-value="60" high-value="80" class="option" />
                    <ui:Slider name="slider-brightness" label="M_BRIGHTNESS" low-value="-1" high-value="1" class="option" />
                    <ui:Button name="button-calibrate" text="M_CALIBRATE" class="option-button" />
                </ui:VisualElement>
                <ui:VisualElement name="pane-audio" class="pane">
                    <ui:Label text="M_SEC_VOLUME" class="section section--first" />
                    <ui:Slider name="slider-master" label="M_GV" low-value="0" high-value="1" class="option" />
                    <ui:Slider name="slider-music" label="M_MUSIC" low-value="0" high-value="1" class="option" />
                    <ui:Slider name="slider-sfx" label="M_SFX" low-value="0" high-value="1" class="option" />
                    <ui:Slider name="slider-voice" label="M_VOICE" low-value="0" high-value="1" class="option" />
                </ui:VisualElement>
                <ui:VisualElement name="pane-controls" class="pane">
                    <ui:Label text="M_SEC_MOUSE" class="section section--first" />
                    <ui:Slider name="slider-sensitivity" label="M_MS" low-value="0.01" high-value="3" class="option" />
                    <OnOffField name="toggle-invert-y" label="M_INVERT_Y" class="option" />
                </ui:VisualElement>
                <ui:VisualElement name="pane-access" class="pane">
                    <ui:Label text="M_SEC_COMFORT" class="section section--first" />
                    <OnOffField name="toggle-reduce-flashes" label="M_REDUCE_FLASH" class="option" />
                    <ui:Slider name="slider-camera-shake" label="M_SHAKE" low-value="0" high-value="1" class="option" />
                </ui:VisualElement>
            </ui:ScrollView>
            <ui:VisualElement class="description">
                <ui:Label name="description" class="description__text" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="options-footer">
            <ui:VisualElement class="prompt">
                <ui:Label name="glyph-change" text="Enter" class="glyph" />
                <ui:Label text="M_CHANGE" class="prompt__text" />
            </ui:VisualElement>
            <ui:Button name="button-defaults" class="prompt" focusable="false">
                <ui:Label name="glyph-defaults" text="R" class="glyph" />
                <ui:Label text="M_DEFAULTS" class="prompt__text" />
            </ui:Button>
            <ui:Button name="button-back" class="prompt" focusable="false">
                <ui:Label name="glyph-back" text="Esc" class="glyph" />
                <ui:Label text="M_BACK" class="prompt__text" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="calibration" class="calibration hidden">
        <ui:Label text="M_BRIGHTNESS" class="calibration__title" />
        <ui:VisualElement name="calibration-stamp" class="calibration__stamp" />
        <ui:Label text="M_CAL_HINT" class="calibration__hint" />
        <ui:Slider name="slider-calibration" low-value="-1" high-value="1" class="calibration__slider" />
        <ui:VisualElement class="options-footer">
            <ui:VisualElement class="prompt">
                <ui:Label name="glyph-adjust" text="← →" class="glyph" />
                <ui:Label text="M_ADJUST" class="prompt__text" />
            </ui:VisualElement>
            <ui:Button name="button-calibration-done" class="prompt" focusable="false">
                <ui:Label name="glyph-confirm" text="Enter" class="glyph" />
                <ui:Label text="M_CONFIRM" class="prompt__text" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
