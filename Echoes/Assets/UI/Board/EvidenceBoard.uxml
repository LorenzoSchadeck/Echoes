<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="../Menu/Menu.uss" />
    <ui:Style src="EvidenceBoard.uss" />
    <ui:VisualElement name="root" class="board-screen">
        <ui:VisualElement name="board" class="board">
            <ui:VisualElement name="empty" picking-mode="Ignore" />
            <ui:VisualElement name="cards" class="cards" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="side" class="board-side">
            <ui:ScrollView name="tray" class="board-tray" />
            <ui:Label name="detail-text" class="board-thought board-hidden" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
