.board-document { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.board-hidden { display: none; }
.board-screen { flex-grow: 1; color: rgb(228, 223, 212); }
.board, .cards { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.board-side { position: absolute; right: 0; top: 0; bottom: 0; width: 31%; padding: 32px 26px; background-color: rgba(0,0,0,.49); }
.board-tray { flex-grow: 1; flex-shrink: 1; }
.evidence-row { min-height: 180px; flex-shrink: 0; flex-direction: row; margin-bottom: 24px; }
.evidence-preview { width: 32%; height: 156px; flex-shrink: 0; }
.evidence-info { flex-grow: 1; justify-content: center; padding: 8px 0 8px 20px; }
.evidence-info Label, .board-thought { -unity-font: url("project://database/Assets/Fonts/Alt has grotesk/AlteHaasGroteskRegular.ttf"); font-size: 22px; white-space: normal; color: rgb(228,223,212); }
.board-thought { padding: 20px 6px; }
.evidence-row:hover .evidence-info Label { color: rgb(247,242,230); }
.evidence-hit { position: absolute; left: 0; top: 0; }
.pin-hit { position: absolute; left: 0; top: 0; width: 28px; height: 28px; }
.tray-empty { display: none; }
.board-side .unity-scroller__low-button, .board-side .unity-scroller__high-button { display: none; }
.board-side .unity-scroller--vertical { width: 5px; }
.board-side .unity-base-slider__tracker { background-color: rgba(0,0,0,0); }
.board-side .unity-base-slider__dragger { background-color: rgba(210,200,180,.25); border-width: 0; border-radius: 0; }
