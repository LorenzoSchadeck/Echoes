/* HUD do jogo: mira, prompt, legendas, inspeção e fades.
   Medidas em relação à resolução de referência 1920x1080 do EchoesPanelSettings. */

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud-text {
    position: absolute;
    -unity-font: url("project://database/Assets/Fonts/B/atwriter.ttf");
    color: rgb(255, 255, 255);
    white-space: normal;
    -unity-text-align: upper-center;
    padding: 0;
    margin: 0;
}

.crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    margin-top: -2px;
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 0.31);
}

.prompt {
    left: 30%;
    right: 30%;
    top: 62%;
    font-size: 30px;
}

/* Legendas na Alte Haas Grotesk; o resto do HUD segue na máquina de escrever */
.speaker {
    -unity-font: url("project://database/Assets/Fonts/Alt%20has%20grotesk/AlteHaasGroteskRegular.ttf");
    left: 30%;
    right: 30%;
    top: 75.4%;
    font-size: 30px;
}

.subtitle {
    -unity-font: url("project://database/Assets/Fonts/Alt%20has%20grotesk/AlteHaasGroteskRegular.ttf");
    left: 30%;
    right: 30%;
    top: 80.5%;
    font-size: 30px;
}

/* Painel escuro à direita com o nome e a descrição do item inspecionado */
.inspect {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 43%;
    background-color: rgba(0, 0, 0, 0.49);
}

.inspect-title {
    left: 6%;
    right: 6%;
    top: 8%;
    font-size: 36px;
    color: rgb(168, 168, 168);
}

.inspect-body {
    left: 8%;
    right: 8%;
    top: 14%;
    font-size: 22px;
    color: rgb(168, 168, 168);
    -unity-text-align: upper-left;
}

.fade {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 0;
}

/* Clarão branco do flash da câmera, por cima da tela preta. As legendas ficam acima dos dois,
   para continuarem legíveis nas telas pretas e brancas. */
.flash {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(255, 255, 255);
    opacity: 0;
}

.end-text {
    left: 22%;
    right: 22%;
    top: 31%;
    font-size: 29px;
    opacity: 0;
}

/* "Segure Espaço para pular", no canto inferior direito, por cima da tela preta */
.skip-hint {
    right: 3%;
    bottom: 4%;
    font-size: 20px;
    -unity-text-align: lower-right;
    color: rgb(230, 224, 212);
}
